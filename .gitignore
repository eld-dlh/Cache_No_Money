# ── Raw Data & Large Datasets (can be multi-GB) ───────────────
data/raw/
*.npy
*.npz
*.h5
*.hdf5
*.parquet

# ── Model Checkpoints & Artifacts ─────────────────────────────
# Ignore intermediate training checkpoints; allow the final best checkpoint
checkpoints/*
!checkpoints/drqn_radar_best.pt
!checkpoints/.gitkeep

# ── Python & Bytecode ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environments ──────────────────────────────────────
.env
.venv/
venv/
ENV/
env.bak/
venv.bak/

# ── IDEs & OS Files ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter Notebooks & Colab ─────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── Caches, Testing & Logging ─────────────────────────────────
.cache/
.pytest_cache/
.coverage
htmlcov/
runs/
logs/
wandb/
